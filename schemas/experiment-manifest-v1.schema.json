{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jadercorrea/ai-experiments/blob/main/schemas/experiment-manifest-v1.schema.json",
  "title": "AI experiment publication manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release",
    "experiment",
    "published_at",
    "harness",
    "models",
    "environment",
    "campaigns",
    "verification",
    "artifacts",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "ai-experiments.manifest/v1"
    },
    "release": {
      "type": "string",
      "pattern": "^[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}\\.[1-9][0-9]*$"
    },
    "experiment": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[a-z0-9/-]*[a-z0-9])?$"
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "repository", "published_revision", "provenance"],
      "properties": {
        "name": {"type": "string"},
        "repository": {"type": "string", "format": "uri"},
        "published_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "provenance": {"type": "string"}
      }
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "digest", "context_window"],
        "properties": {
          "name": {"type": "string"},
          "digest": {"type": "string"},
          "context_window": {"type": "integer", "minimum": 1}
        }
      }
    },
    "environment": {
      "type": "object"
    },
    "campaigns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "purpose",
          "runs",
          "passed",
          "timed_out",
          "median_duration"
        ],
        "properties": {
          "id": {"type": "string"},
          "purpose": {"type": "string"},
          "runs": {"type": "integer", "minimum": 1},
          "passed": {"type": "integer", "minimum": 0},
          "timed_out": {"type": "integer", "minimum": 0},
          "median_duration": {"type": "string"}
        }
      }
    },
    "verification": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {"type": "string"}
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "sha256"],
        "properties": {
          "name": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
