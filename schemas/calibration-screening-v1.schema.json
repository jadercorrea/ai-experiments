{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jadercorrea/ai-experiments/blob/main/schemas/calibration-screening-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "selected_at", "candidates"],
  "properties": {
    "schema_version": {"const": "ai-experiments.calibration-screening/v1"},
    "status": {"enum": ["selected-pending-reproduction", "reproduced-frozen"]},
    "selected_at": {"type": "string", "format": "date-time"},
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/candidate"}
    }
  },
  "$defs": {
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "repository", "license_spdx", "source_number", "source_url",
        "source_created_at", "source_body_sha256", "problem_statement",
        "base_commit", "reference_commit", "reference_merged_at",
        "solution_paths", "test_paths", "focal_test_command",
        "regression_command", "provisional_stratum"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:[a-z0-9-]*[a-z0-9])?$"},
        "repository": {"type": "string", "pattern": "^https://github\\.com/[^/]+/[^/]+/?$"},
        "license_spdx": {"type": "string", "minLength": 1},
        "source_number": {"type": "integer", "minimum": 1},
        "source_url": {"type": "string", "pattern": "^https://github\\.com/[^/]+/[^/]+/(issues|pull)/[1-9][0-9]*$"},
        "source_created_at": {"type": "string", "format": "date-time"},
        "source_body_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "problem_statement": {"type": "string", "minLength": 1},
        "public_test_command": {"$ref": "#/$defs/command"},
        "base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "reference_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "reference_merged_at": {"type": "string", "format": "date-time"},
        "solution_paths": {"$ref": "#/$defs/paths"},
        "test_paths": {"$ref": "#/$defs/paths"},
        "focal_test_command": {"$ref": "#/$defs/command"},
        "regression_command": {"$ref": "#/$defs/command"},
        "provisional_stratum": {"enum": ["L1", "L2", "L3"]},
        "reference_authorship_note": {"type": "string", "minLength": 1}
      }
    }
  }
}
