{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jadercorrea/ai-experiments/blob/main/schemas/construction-candidates-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "language", "purpose", "candidates"],
  "properties": {
    "schema_version": {"const": "ai-experiments.construction-candidates/v1"},
    "language": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "candidates": {
      "type": "array",
      "minItems": 3,
      "items": {"$ref": "#/$defs/candidate"}
    }
  },
  "$defs": {
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "repository", "license_spdx", "source_kind",
        "source_number", "source_url", "source_created_at",
        "source_body_sha256", "problem_statement_method",
        "problem_statement", "base_commit", "reference_commit",
        "reference_merged_at", "solution_paths", "test_paths",
        "focal_test_command", "regression_command", "observed_transition"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:[a-z0-9-]*[a-z0-9])?$"},
        "repository": {"type": "string", "pattern": "^https://github\\.com/[^/]+/[^/]+/?$"},
        "license_spdx": {"type": "string", "minLength": 1},
        "source_kind": {"enum": ["issue", "pull_request"]},
        "source_number": {"type": "integer", "minimum": 1},
        "source_url": {"type": "string", "pattern": "^https://github\\.com/[^/]+/[^/]+/(issues|pull)/[1-9][0-9]*$"},
        "source_created_at": {"type": "string", "format": "date-time"},
        "source_body_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "problem_statement_method": {"enum": ["verbatim", "curated_excerpt"]},
        "problem_statement": {"type": "string", "minLength": 1},
        "base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "reference_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "reference_merged_at": {"type": "string", "format": "date-time"},
        "solution_paths": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "test_paths": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "focal_test_command": {"$ref": "#/$defs/command"},
        "regression_command": {"$ref": "#/$defs/command"},
        "observed_transition": {
          "type": "object",
          "additionalProperties": false,
          "required": ["test_only", "reference_solution"],
          "properties": {
            "test_only": {"const": "FAIL"},
            "reference_solution": {"const": "PASS"}
          }
        }
      }
    }
  }
}
