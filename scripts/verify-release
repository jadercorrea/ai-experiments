#!/usr/bin/env bash

set -euo pipefail

if [[ $# -ne 2 ]]; then
  echo "usage: $0 <checksums-file> <archive>" >&2
  exit 2
fi

checksums=$1
archive=$2

if [[ ! -f "$checksums" || ! -f "$archive" ]]; then
  echo "checksum file and archive must both exist" >&2
  exit 1
fi

expected=$(
  awk -v name="$(basename "$archive")" '$2 == name { print $1 }' "$checksums"
)
if [[ -z "$expected" ]]; then
  echo "archive is not listed in $checksums" >&2
  exit 1
fi

actual=$(shasum -a 256 "$archive" | awk '{ print $1 }')
if [[ "$actual" != "$expected" ]]; then
  echo "checksum mismatch for $(basename "$archive")" >&2
  exit 1
fi

case "$archive" in
  *.tar.gz|*.tgz)
    tar -tzf "$archive" >/dev/null
    ;;
  *)
    echo "unsupported archive format: $archive" >&2
    exit 1
    ;;
esac

echo "verified $(basename "$archive")"
