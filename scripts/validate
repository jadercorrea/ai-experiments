#!/usr/bin/env bash

set -euo pipefail

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
schema="$root/schemas/experiment-manifest-v1.schema.json"
profile=${1:-full}
python_bin=${PYTHON_BIN:-python3}

if [[ $# -gt 1 || ("$profile" != "full" && "$profile" != "--ci") ]]; then
  printf 'usage: %s [--ci]\n' "$0" >&2
  exit 2
fi

bash -n "$root/scripts/verify-release"

if [[ "$profile" == "--ci" ]]; then
  "$python_bin" -m unittest \
    tests.test_build_artifact_lock \
    tests.test_handoff_audits \
    tests.test_handoff_protocol \
    tests.test_handoff_protocol_preview \
    tests.test_historical_session_execution_freezes \
    tests.test_compacted_session_calibration_observation \
    tests.test_coverage_session_calibration_observation \
    tests.test_progress_session_calibration_observation \
    tests.test_semantic_session_state_replay_v1.SemanticSessionStateReplayV1Test.test_evaluator_stack_paths_are_canonical_across_workspaces \
    tests.test_semantic_session_state_replay_v1.SemanticSessionStateReplayV1Test.test_source_patch_rejection_diagnostics_are_git_version_independent
else
  "$python_bin" -m unittest discover -s "$root/tests" -p "test_*.py"
fi

while IFS= read -r -d '' artifact_lock; do
  "$python_bin" "$root/scripts/build_artifact_lock.py" \
    "$(dirname "$(dirname "$artifact_lock")")" \
    "$artifact_lock" \
    --verify
done < <(find "$root/experiments" -name artifact-lock.json -print0)

for benchmark_schema in "$root"/schemas/benchmark-task-*.schema.json; do
  "$python_bin" - "$benchmark_schema" <<'PY'
import json
import pathlib
import sys

import jsonschema

schema_path = pathlib.Path(sys.argv[1])
with schema_path.open() as schema_file:
    schema = json.load(schema_file)

jsonschema.Draft202012Validator.check_schema(schema)
PY
done

"$python_bin" - "$root" <<'PY'
import json
import pathlib
import sys

import jsonschema

root = pathlib.Path(sys.argv[1])
with (root / "schemas/calibration-screening-v1.schema.json").open() as schema_file:
    schema = json.load(schema_file)
validator = jsonschema.Draft202012Validator(
    schema,
    format_checker=jsonschema.FormatChecker(),
)
for screening_path in root.glob("experiments/**/calibration/screening.json"):
    with screening_path.open() as screening_file:
        screening = json.load(screening_file)
    validator.validate(screening)
    ids = [candidate["id"] for candidate in screening["candidates"]]
    repositories = [candidate["repository"] for candidate in screening["candidates"]]
    if len(ids) != len(set(ids)):
        raise ValueError(f"duplicate calibration candidate id: {screening_path}")
    if len(repositories) != len(set(repositories)):
        raise ValueError(f"calibration repositories are not disjoint: {screening_path}")
PY

"$python_bin" - "$root" <<'PY'
import json
import pathlib
import sys

import jsonschema

root = pathlib.Path(sys.argv[1])
sys.path.insert(0, str(root / "scripts"))
from benchmark_tasks import validate_candidate_set

schema_path = root / "schemas" / "construction-candidates-v1.schema.json"
with schema_path.open() as schema_file:
    schema = json.load(schema_file)
validator = jsonschema.Draft202012Validator(
    schema,
    format_checker=jsonschema.FormatChecker(),
)
for candidate_path in root.glob("experiments/**/construction/candidates.json"):
    with candidate_path.open() as candidate_file:
        candidate_set = json.load(candidate_file)
    validator.validate(candidate_set)
    validate_candidate_set(candidate_set)
PY

while IFS= read -r -d '' manifest; do
  "$python_bin" - "$schema" "$manifest" <<'PY'
import json
import pathlib
import sys

import jsonschema

schema_path, manifest_path = map(pathlib.Path, sys.argv[1:])
with schema_path.open() as schema_file:
    schema = json.load(schema_file)
with manifest_path.open() as manifest_file:
    manifest = json.load(manifest_file)

jsonschema.Draft202012Validator(
    schema,
    format_checker=jsonschema.FormatChecker(),
).validate(manifest)
PY
done < <(find "$root/experiments" -name manifest.json -print0)

while IFS= read -r -d '' task; do
  "$python_bin" "$root/scripts/benchmark_tasks.py" "$task"
done < <(find "$root/experiments" -name benchmark-task.json -print0)

"$python_bin" - "$root" <<'PY'
import json
import pathlib
import sys

import jsonschema

root = pathlib.Path(sys.argv[1])
with (root / "schemas/model-lock-v1.schema.json").open() as schema_file:
    schema = json.load(schema_file)
validator = jsonschema.Draft202012Validator(
    schema,
    format_checker=jsonschema.FormatChecker(),
)
for lock_path in root.glob("experiments/**/model-lock.json"):
    with lock_path.open() as lock_file:
        validator.validate(json.load(lock_file))
PY

echo "repository validation passed"
