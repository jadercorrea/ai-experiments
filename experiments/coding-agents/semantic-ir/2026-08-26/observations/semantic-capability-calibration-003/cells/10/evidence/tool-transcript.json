          "content": "{\n  \"schema_version\": \"ai-experiments.semantic-ir.program/v2\",\n  \"program_id\": \"program:capability-v2-directory-fallback-001\",\n  \"catalog_version\": \"ai-experiments.semantic-ir.catalog/v2\",\n  \"function\": {\n    \"symbol_id\": \"fn:final-directory-fallback-001-lookup-user\",\n    \"name\": \"processWithDirectory\",\n    \"parameters\": [\n      {\n        \"symbol_id\": \"param:capability-v2-directory-fallback-001-raw-id\",\n        \"name\": \"rawId\",\n        \"type\": \"string\"\n      }\n    ],\n    \"return_type\": \"result<user,string>\",\n    \"effects\": [\n      \"db.read:users\"\n    ],\n    \"body\": {\n      \"node_id\": \"node:capability-v2-directory-fallback-001-normalize-let\",\n      \"op\": \"let\",\n      \"binding\": {\n        \"symbol_id\": \"local:capability-v2-directory-fallback-001-normalized-id\",\n        \"name\": \"normalizedId\",\n        \"type\": \"string\"\n      },\n      \"value\": {\n        \"node_id\": \"node:capability-v2-directory-fallback-001-trim\",\n        \"op\": \"call\",\n        \"symbol\": \"string.trim_ascii\",\n        \"arguments\": [\n          {\n            \"node_id\": \"node:capability-v2-directory-fallback-001-raw-id-ref\",\n            \"op\": \"var\",\n            \"symbol_id\": \"param:capability-v2-directory-fallback-001-raw-id\"\n          }\n        ]\n      },\n      \"then\": {\n        \"node_id\": \"node:capability-v2-directory-fallback-001-validity-if\",\n        \"op\": \"if\",\n        \"condition\": {\n          \"node_id\": \"node:capability-v2-directory-fallback-001-is-empty\",\n          \"op\": \"call\",\n          \"symbol\": \"string.is_empty\",\n          \"arguments\": [\n            {\n              \"node_id\": \"node:capability-v2-directory-fallback-001-normalized-ref-for-empty\",\n              \"op\": \"var\",\n              \"symbol_id\": \"local:capability-v2-directory-fallback-001-normalized-id\"\n            }\n          ]\n        },\n        \"then\": {\n          \"node_id\": \"node:capability-v2-directory-fallback-001-invalid-id\",\n          \"op\": \"err\",\n          \"error\": {\n            \"node_id\": \"node:capability-v2-directory-fallback-001-invalid-id-code\",\n            \"op\": \"string\",\n            \"value\": \"invalid_user_id\"\n          }\n        },\n        \"else\": {\n          \"node_id\": \"node:capability-v2-directory-fallback-001-user-match\",\n          \"op\": \"option_match\",\n          \"value\": {\n            \"node_id\": \"node:capability-v2-directory-fallback-001-get-user\",\n            \"op\": \"call\",\n            \"symbol\": \"users.get_by_id\",\n            \"arguments\": [\n              {\n                \"node_id\": \"node:capability-v2-directory-fallback-001-normalized-ref-for-lookup\",\n                \"op\": \"var\",\n                \"symbol_id\": \"local:capability-v2-directory-fallback-001-normalized-id\"\n              }\n            ]\n          },\n          \"some_binding\": {\n            \"symbol_id\": \"local:capability-v2-directory-fallback-001-user\",\n            \"name\": \"user\",\n            \"type\": \"user\"\n          },\n          \"none\": {\n            \"node_id\": \"node:capability-v2-directory-fallback-001-not-found\",\n            \"op\": \"err\",\n            \"error\": {\n              \"node_id\": \"node:capability-v2-directory-fallback-001-not-found-code\",\n              \"op\": \"string\",\n              \"value\": \"not_found\"\n            }\n          },\n          \"some\": {\n            \"node_id\": \"node:capability-v2-directory-fallback-001-found\",\n            \"op\": \"ok\",\n            \"value\": {\n              \"node_id\": \"node:capability-v2-directory-fallback-001-user-ref\",\n              \"op\": \"var\",\n              \"symbol_id\": \"local:capability-v2-directory-fallback-001-user\"\n            }\n          }\n        }\n      }\n    }\n  }\n}\n",
