          "content": "// Generated deterministically from semantic IR. Do not edit.\nexport type User = Readonly<{ id: string; name: string }>;\nexport type Result<T, E> = { ok: T } | { error: E };\nexport type SemanticCapabilities = Readonly<{\n  users: Readonly<{ getById(id: string): User | undefined }>;\n}>;\n\nexport function resolveWithRetry(\n  rawId: string, capabilities: SemanticCapabilities\n): Result<User, string> {\n  return /* ir:node:context-v1-raw-id-retry-001-normalize-let */ (() => {\n    const normalizedId: string = /* ir:node:context-v1-raw-id-retry-001-trim */ (/* ir:node:context-v1-raw-id-retry-001-raw-id-ref */ rawId).replace(/^[\\t\\n\\v\\f\\r ]+|[\\t\\n\\v\\f\\r ]+$/g, \"\");\n    return /* ir:node:context-v1-raw-id-retry-001-validity-if */ (/* ir:node:context-v1-raw-id-retry-001-is-empty */ (/* ir:node:context-v1-raw-id-retry-001-normalized-ref-for-empty */ normalizedId).length === 0)\n      ? (/* ir:node:context-v1-raw-id-retry-001-invalid-id */ { error: /* ir:node:context-v1-raw-id-retry-001-invalid-id-code */ \"invalid_user_id\" })\n      : (/* ir:node:context-v1-raw-id-retry-001-user-match */ (() => {\n          const __semantic_ir_option_1 = /* ir:node:context-v1-raw-id-retry-001-get-user */ capabilities.users.getById(/* ir:node:context-v1-raw-id-retry-001-normalized-ref-for-lookup */ normalizedId);\n          if (__semantic_ir_option_1 === undefined) {\n            return /* ir:node:context-v1-raw-id-retry-001-not-found */ { error: /* ir:node:context-v1-raw-id-retry-001-not-found-code */ \"not_found\" };\n          }\n          const user: User = __semantic_ir_option_1;\n          return /* ir:node:context-v1-raw-id-retry-001-found */ { ok: /* ir:node:context-v1-raw-id-retry-001-user-ref */ user };\n        })());\n  })();\n}\n",
