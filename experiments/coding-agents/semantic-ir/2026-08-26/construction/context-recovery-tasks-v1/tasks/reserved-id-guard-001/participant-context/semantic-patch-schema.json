{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gptcode.dev/schemas/semantic-ir/semantic-patch-v0.schema.json",
  "title": "Transactional semantic patch v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "patch_id",
    "program_id",
    "base_program_sha256",
    "operations"
  ],
  "properties": {
    "schema_version": {
      "const": "ai-experiments.semantic-ir.patch/v0"
    },
    "patch_id": {
      "$ref": "#/$defs/semanticIdentifier"
    },
    "program_id": {
      "$ref": "#/$defs/semanticIdentifier"
    },
    "base_program_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/replaceSubtree"
      }
    }
  },
  "$defs": {
    "semanticIdentifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?::[a-z][a-z0-9-]*)+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "replaceSubtree": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "op",
        "target_node_id",
        "expected_subtree_sha256",
        "replacement"
      ],
      "properties": {
        "operation_id": {
          "$ref": "#/$defs/semanticIdentifier"
        },
        "op": {
          "const": "replace_subtree"
        },
        "target_node_id": {
          "$ref": "#/$defs/semanticIdentifier"
        },
        "expected_subtree_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "replacement": {
          "$ref": "https://gptcode.dev/schemas/semantic-ir/program-ir-v0.schema.json#/$defs/expression"
        }
      }
    }
  }
}
