{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gptcode.dev/schemas/semantic-ir/program-ir-v0.schema.json",
  "title": "Semantic IR construction slice v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "program_id",
    "catalog_version",
    "function"
  ],
  "properties": {
    "schema_version": {
      "const": "ai-experiments.semantic-ir.program/v0"
    },
    "program_id": {
      "$ref": "#/$defs/semanticIdentifier"
    },
    "catalog_version": {
      "const": "ai-experiments.semantic-ir.catalog/v0"
    },
    "function": {
      "$ref": "#/$defs/function"
    }
  },
  "$defs": {
    "semanticIdentifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?::[a-z][a-z0-9-]*)+$"
    },
    "sourceIdentifier": {
      "type": "string",
      "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"
    },
    "valueType": {
      "enum": [
        "string",
        "boolean",
        "user",
        "option<user>",
        "result<user,string>"
      ]
    },
    "effect": {
      "enum": ["db.read:users"]
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symbol_id", "name", "type"],
      "properties": {
        "symbol_id": {
          "$ref": "#/$defs/semanticIdentifier"
        },
        "name": {
          "$ref": "#/$defs/sourceIdentifier"
        },
        "type": {
          "$ref": "#/$defs/valueType"
        }
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symbol_id", "name", "type"],
      "properties": {
        "symbol_id": {
          "$ref": "#/$defs/semanticIdentifier"
        },
        "name": {
          "$ref": "#/$defs/sourceIdentifier"
        },
        "type": {
          "const": "string"
        }
      }
    },
    "function": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "symbol_id",
        "name",
        "parameters",
        "return_type",
        "effects",
        "body"
      ],
      "properties": {
        "symbol_id": {
          "$ref": "#/$defs/semanticIdentifier"
        },
        "name": {
          "$ref": "#/$defs/sourceIdentifier"
        },
        "parameters": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/parameter"
          }
        },
        "return_type": {
          "const": "result<user,string>"
        },
        "effects": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/effect"
          }
        },
        "body": {
          "$ref": "#/$defs/expression"
        }
      }
    },
    "nodeHeader": {
      "type": "object",
      "required": ["node_id", "op"],
      "properties": {
        "node_id": {
          "$ref": "#/$defs/semanticIdentifier"
        }
      }
    },
    "stringExpression": {
      "allOf": [
        {"$ref": "#/$defs/nodeHeader"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["node_id", "op", "value"],
          "properties": {
            "node_id": {"$ref": "#/$defs/semanticIdentifier"},
            "op": {"const": "string"},
            "value": {"type": "string"}
          }
        }
      ]
    },
    "variableExpression": {
      "allOf": [
        {"$ref": "#/$defs/nodeHeader"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["node_id", "op", "symbol_id"],
          "properties": {
            "node_id": {"$ref": "#/$defs/semanticIdentifier"},
            "op": {"const": "var"},
            "symbol_id": {"$ref": "#/$defs/semanticIdentifier"}
          }
        }
      ]
    },
    "callExpression": {
      "allOf": [
        {"$ref": "#/$defs/nodeHeader"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["node_id", "op", "symbol", "arguments"],
          "properties": {
            "node_id": {"$ref": "#/$defs/semanticIdentifier"},
            "op": {"const": "call"},
            "symbol": {"type": "string", "minLength": 1},
            "arguments": {
              "type": "array",
              "items": {"$ref": "#/$defs/expression"}
            }
          }
        }
      ]
    },
    "letExpression": {
      "allOf": [
        {"$ref": "#/$defs/nodeHeader"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["node_id", "op", "binding", "value", "then"],
          "properties": {
            "node_id": {"$ref": "#/$defs/semanticIdentifier"},
            "op": {"const": "let"},
            "binding": {"$ref": "#/$defs/binding"},
            "value": {"$ref": "#/$defs/expression"},
            "then": {"$ref": "#/$defs/expression"}
          }
        }
      ]
    },
    "ifExpression": {
      "allOf": [
        {"$ref": "#/$defs/nodeHeader"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["node_id", "op", "condition", "then", "else"],
          "properties": {
            "node_id": {"$ref": "#/$defs/semanticIdentifier"},
            "op": {"const": "if"},
            "condition": {"$ref": "#/$defs/expression"},
            "then": {"$ref": "#/$defs/expression"},
            "else": {"$ref": "#/$defs/expression"}
          }
        }
      ]
    },
    "optionMatchExpression": {
      "allOf": [
        {"$ref": "#/$defs/nodeHeader"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "node_id",
            "op",
            "value",
            "some_binding",
            "none",
            "some"
          ],
          "properties": {
            "node_id": {"$ref": "#/$defs/semanticIdentifier"},
            "op": {"const": "option_match"},
            "value": {"$ref": "#/$defs/expression"},
            "some_binding": {"$ref": "#/$defs/binding"},
            "none": {"$ref": "#/$defs/expression"},
            "some": {"$ref": "#/$defs/expression"}
          }
        }
      ]
    },
    "okExpression": {
      "allOf": [
        {"$ref": "#/$defs/nodeHeader"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["node_id", "op", "value"],
          "properties": {
            "node_id": {"$ref": "#/$defs/semanticIdentifier"},
            "op": {"const": "ok"},
            "value": {"$ref": "#/$defs/expression"}
          }
        }
      ]
    },
    "errorExpression": {
      "allOf": [
        {"$ref": "#/$defs/nodeHeader"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["node_id", "op", "error"],
          "properties": {
            "node_id": {"$ref": "#/$defs/semanticIdentifier"},
            "op": {"const": "err"},
            "error": {"$ref": "#/$defs/expression"}
          }
        }
      ]
    },
    "expression": {
      "oneOf": [
        {"$ref": "#/$defs/stringExpression"},
        {"$ref": "#/$defs/variableExpression"},
        {"$ref": "#/$defs/callExpression"},
        {"$ref": "#/$defs/letExpression"},
        {"$ref": "#/$defs/ifExpression"},
        {"$ref": "#/$defs/optionMatchExpression"},
        {"$ref": "#/$defs/okExpression"},
        {"$ref": "#/$defs/errorExpression"}
      ]
    }
  }
}
