{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gptcode.dev/schemas/semantic-ir/semantic-patch-suite-v0.schema.json",
  "title": "Semantic patch heterogeneous candidate matrix v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "suite_id",
    "status",
    "claim_boundary",
    "contrast",
    "task_matrix",
    "extension_policy",
    "analysis_policy",
    "final_task_gate",
    "integrity"
  ],
  "properties": {
    "schema_version": {
      "const": "ai-experiments.semantic-ir.semantic-patch-suite/v0"
    },
    "suite_id": {
      "const": "semantic-ir-candidates/heterogeneous-patches-v0"
    },
    "status": {"const": "candidate_matrix_frozen"},
    "claim_boundary": {"$ref": "#/$defs/claimBoundary"},
    "contrast": {"$ref": "#/$defs/contrast"},
    "task_matrix": {"$ref": "#/$defs/taskMatrix"},
    "extension_policy": {"$ref": "#/$defs/extensionPolicy"},
    "analysis_policy": {"$ref": "#/$defs/analysisPolicy"},
    "final_task_gate": {"$ref": "#/$defs/finalTaskGate"},
    "integrity": {"$ref": "#/$defs/integrity"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
    },
    "claimBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_calls_authorized",
        "efficacy_claim_authorized",
        "concrete_tasks_sealed",
        "frozen_now",
        "deferred"
      ],
      "properties": {
        "model_calls_authorized": {"const": false},
        "efficacy_claim_authorized": {"const": false},
        "concrete_tasks_sealed": {"const": false},
        "frozen_now": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "deferred": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "arm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "persistent_state", "terminal_submission"],
      "properties": {
        "name": {"enum": ["source_patch", "semantic_patch"]},
        "persistent_state": {
          "enum": ["locked_repository_source", "locked_canonical_semantic_ir"]
        },
        "terminal_submission": {
          "enum": ["unified_diff", "checked_semantic_patch_or_unsupported"]
        }
      }
    },
    "contrast": {
      "type": "object",
      "additionalProperties": false,
      "required": ["independent_variable", "arms", "shared_controls"],
      "properties": {
        "independent_variable": {"const": "patch_representation_over_persistent_state"},
        "arms": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/arm"}
        },
        "shared_controls": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "stratum",
        "size_band",
        "participant_objective",
        "required_semantics",
        "expected_files_changed",
        "required_patch_operations",
        "support_at_candidate_freeze",
        "support_reason",
        "extension_gate",
        "fresh_instance_required",
        "task_sha256"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(?:[/:][a-z0-9-]+)+$"
        },
        "stratum": {
          "enum": [
            "local_literal",
            "dataflow",
            "control_flow",
            "effect",
            "repository_scope"
          ]
        },
        "size_band": {"enum": ["small", "medium", "large"]},
        "participant_objective": {"type": "string", "minLength": 1},
        "required_semantics": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "expected_files_changed": {"type": "integer", "minimum": 1},
        "required_patch_operations": {
          "type": "array",
          "uniqueItems": true,
          "items": {"const": "replace_subtree"}
        },
        "support_at_candidate_freeze": {
          "enum": [
            "supported_v0",
            "extension_required",
            "intentionally_unsupported"
          ]
        },
        "support_reason": {"type": "string", "minLength": 1},
        "extension_gate": {"type": ["string", "null"], "minLength": 1},
        "fresh_instance_required": {"const": true},
        "task_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "taskMatrix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_strata", "required_size_counts", "tasks"],
      "properties": {
        "required_strata": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "required_size_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["small", "medium", "large"],
          "properties": {
            "small": {"type": "integer", "minimum": 1},
            "medium": {"type": "integer", "minimum": 1},
            "large": {"type": "integer", "minimum": 1}
          }
        },
        "tasks": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/task"}
        }
      }
    },
    "extensionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_before_final_task_lock",
        "task_identity_must_remain_stable",
        "must_be_justified_by_required_semantics",
        "model_outcomes_may_influence",
        "allowed_after_first_model_call"
      ],
      "properties": {
        "allowed_before_final_task_lock": {"const": true},
        "task_identity_must_remain_stable": {"const": true},
        "must_be_justified_by_required_semantics": {"const": true},
        "model_outcomes_may_influence": {"const": false},
        "allowed_after_first_model_call": {"const": false}
      }
    },
    "estimand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "denominator"],
      "properties": {
        "metric": {"const": "hidden_pass_at_1"},
        "denominator": {
          "enum": [
            "all_locked_tasks",
            "tasks_supported_by_both_arms_at_final_lock"
          ]
        },
        "semantic_unsupported_outcome": {"const": "counts_as_failure"},
        "must_be_reported_with_all_task_utility": {"const": true}
      }
    },
    "analysisPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "all_task_utility",
        "conditional_efficacy",
        "token_accounting",
        "mandatory_secondary_metrics"
      ],
      "properties": {
        "all_task_utility": {"$ref": "#/$defs/estimand"},
        "conditional_efficacy": {"$ref": "#/$defs/estimand"},
        "token_accounting": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "counted_content"],
          "properties": {
            "source": {"const": "provider_native_usage"},
            "counted_content": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            }
          }
        },
        "mandatory_secondary_metrics": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "finalTaskGate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "concrete_task_count",
        "same_task_instance_for_both_arms",
        "same_hidden_evaluator_for_both_arms",
        "hidden_evaluators_must_be_sealed",
        "reference_solutions_excluded_from_participant_tree",
        "task_trees_content_locked",
        "contamination_audit_required",
        "final_support_disposition_locked_before_model_calls",
        "baseline_must_fail_hidden_evaluator",
        "reference_solution_must_pass_hidden_evaluator",
        "public_hidden_discrimination_required",
        "candidate_rejection_reasons_predeclared",
        "rejected_candidates_retained",
        "selection_may_use_model_outcomes"
      ],
      "properties": {
        "concrete_task_count": {"const": 6},
        "same_task_instance_for_both_arms": {"const": true},
        "same_hidden_evaluator_for_both_arms": {"const": true},
        "hidden_evaluators_must_be_sealed": {"const": true},
        "reference_solutions_excluded_from_participant_tree": {"const": true},
        "task_trees_content_locked": {"const": true},
        "contamination_audit_required": {"const": true},
        "final_support_disposition_locked_before_model_calls": {"const": true},
        "baseline_must_fail_hidden_evaluator": {"const": true},
        "reference_solution_must_pass_hidden_evaluator": {"const": true},
        "public_hidden_discrimination_required": {"const": true},
        "candidate_rejection_reasons_predeclared": {"const": true},
        "rejected_candidates_retained": {"const": true},
        "selection_may_use_model_outcomes": {"const": false}
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dependencies", "suite_sha256"],
      "properties": {
        "dependencies": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/dependency"}
        },
        "suite_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
