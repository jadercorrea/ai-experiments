{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gptcode.dev/schemas/semantic-ir/provider-schema-capability-probe-result-v2.schema.json",
  "title": "Provider schema capability probe result v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "probe_id",
    "status",
    "started_at",
    "completed_at",
    "execution_freeze_sha256",
    "grammar_artifact_lock_sha256",
    "authorization_sha256",
    "commit_schema_sha256",
    "finish_schema_sha256",
    "provider",
    "provider_model",
    "api_format",
    "synthetic_messages_only",
    "provider_requests",
    "calibration_subject_requests",
    "provider_schema_acceptance_observed",
    "provider_schema_rejection_observed",
    "root_type_rejection_observed",
    "validation_advanced_beyond_root_observed",
    "inner_keyword_acceptance_observed",
    "inner_keyword_rejection_observed",
    "classification_revision",
    "classification_corrected_offline",
    "sampled_valid_outputs",
    "constrained_decoding_guaranteed",
    "calibration_launch_authorized",
    "usage",
    "estimated_cost_usd",
    "cases",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {
      "const": "ai-experiments.semantic-ir.provider-schema-capability-probe-result/v2"
    },
    "probe_id": {"type": "string", "minLength": 1},
    "status": {
      "enum": [
        "provider_schema_accepted",
        "provider_schema_rejected",
        "infrastructure_invalid"
      ]
    },
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "execution_freeze_sha256": {"$ref": "#/$defs/sha256"},
    "grammar_artifact_lock_sha256": {"$ref": "#/$defs/sha256"},
    "authorization_sha256": {"$ref": "#/$defs/sha256"},
    "commit_schema_sha256": {"$ref": "#/$defs/sha256"},
    "finish_schema_sha256": {"$ref": "#/$defs/sha256"},
    "provider": {"const": "Amazon Bedrock"},
    "provider_model": {"type": "string", "minLength": 1},
    "api_format": {"const": "bedrock-converse"},
    "synthetic_messages_only": {"const": true},
    "provider_requests": {"type": "integer", "minimum": 0, "maximum": 2},
    "calibration_subject_requests": {"const": 0},
    "provider_schema_acceptance_observed": {"type": "boolean"},
    "provider_schema_rejection_observed": {"type": "boolean"},
    "root_type_rejection_observed": {"type": "boolean"},
    "validation_advanced_beyond_root_observed": {"type": "boolean"},
    "inner_keyword_acceptance_observed": {"type": "boolean"},
    "inner_keyword_rejection_observed": {"type": "boolean"},
    "classification_revision": {"const": 2},
    "classification_corrected_offline": {"type": "boolean"},
    "sampled_valid_outputs": {"type": "integer", "minimum": 0, "maximum": 2},
    "constrained_decoding_guaranteed": {"const": false},
    "calibration_launch_authorized": {"const": false},
    "usage": {"type": "object"},
    "estimated_cost_usd": {"type": "number", "minimum": 0},
    "cases": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/case"}
    },
    "claim_boundary": {"type": "object"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "phase",
        "adversarial",
        "schema_sha256",
        "request_sha256",
        "status_code",
        "provider_schema_accepted",
        "provider_schema_rejected",
        "response_sha256",
        "provider_error_message",
        "model_identity_match",
        "tool_call_observed",
        "sampled_tool_arguments",
        "sampled_tool_arguments_schema_valid",
        "validation_errors",
        "finish_reason",
        "usage",
        "infrastructure_error"
      ],
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "phase": {"enum": ["commit", "finish"]},
        "adversarial": {"type": "boolean"},
        "schema_sha256": {"$ref": "#/$defs/sha256"},
        "request_sha256": {"$ref": "#/$defs/sha256"},
        "status_code": {"type": ["integer", "null"]},
        "provider_schema_accepted": {"type": "boolean"},
        "provider_schema_rejected": {"type": "boolean"},
        "response_sha256": {"type": ["string", "null"]},
        "provider_error_message": {"type": ["string", "null"]},
        "model_identity_match": {"type": ["boolean", "null"]},
        "tool_call_observed": {"type": "boolean"},
        "sampled_tool_arguments": {"type": ["object", "null"]},
        "sampled_tool_arguments_schema_valid": {"type": ["boolean", "null"]},
        "validation_errors": {
          "type": "array",
          "items": {"type": "string"}
        },
        "finish_reason": {"type": ["string", "null"]},
        "usage": {"type": "object"},
        "infrastructure_error": {"type": ["string", "null"]}
      }
    }
  }
}
