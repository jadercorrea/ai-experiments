{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gptcode.dev/schemas/semantic-ir/representational-diagnostic-participant-runtime-freeze-v3.schema.json",
  "title": "Diagnostic participant runtime local replay freeze v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "runtime_version", "source_sha256", "replay", "accounting", "claim_boundary"],
  "properties": {
    "schema_version": {"const": "ai-experiments.semantic-ir.representational-diagnostic-participant-runtime-freeze/v3"},
    "status": {"const": "diagnostic_runtime_local_replay_passed_launch_blocked"},
    "runtime_version": {"const": "ai-experiments.semantic-ir.representational-diagnostic-participant/v3"},
    "source_sha256": {"type": "object", "minProperties": 14, "maxProperties": 14, "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "replay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["historical_turns", "historical_tool_calls", "historical_diagnostics", "historical_codes", "historical_state_round_trips", "historical_applied_mutations", "historical_workspace_tree_sha256", "historical_records_sha256", "reference_applied_mutations", "reference_workspace_tree_sha256", "reference_result_sha256", "semantic_corpus_diagnostics", "semantic_corpus_codes", "unsupported_plain_errors"],
      "properties": {
        "historical_turns": {"const": 8},
        "historical_tool_calls": {"const": 8},
        "historical_diagnostics": {"const": 3},
        "historical_codes": {"const": ["S_OPERATION_ARITY", "MOTION_PATCH_ID_PATTERN", "MOTION_ROOT_PATTERN"]},
        "historical_state_round_trips": {"const": 8},
        "historical_applied_mutations": {"const": 0},
        "historical_workspace_tree_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "historical_records_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "reference_applied_mutations": {"const": 1},
        "reference_workspace_tree_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "reference_result_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "semantic_corpus_diagnostics": {"const": 10},
        "semantic_corpus_codes": {"type": "array", "minItems": 10, "maxItems": 10, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"}},
        "unsupported_plain_errors": {"const": 1}
      }
    },
    "accounting": {
      "type": "object", "additionalProperties": false,
      "required": ["provider_requests", "external_launches"],
      "properties": {"provider_requests": {"const": 0}, "external_launches": {"const": 0}}
    },
    "claim_boundary": {
      "type": "object", "additionalProperties": false,
      "required": ["model_repair_observed", "participant_treatment_launched", "external_launch_authorized", "remaining_cells_blocked"],
      "properties": {
        "model_repair_observed": {"const": false},
        "participant_treatment_launched": {"const": false},
        "external_launch_authorized": {"const": false},
        "remaining_cells_blocked": {"const": 957}
      }
    }
  }
}
