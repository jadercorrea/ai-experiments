{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gptcode.dev/schemas/semantic-ir/program-ir-v2.schema.json",
  "title": "Semantic IR construction slice v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "program_id",
    "catalog_version",
    "function"
  ],
  "properties": {
    "schema_version": {
      "const": "ai-experiments.semantic-ir.program/v2"
    },
    "program_id": {
      "$ref": "https://gptcode.dev/schemas/semantic-ir/program-ir-v0.schema.json#/$defs/semanticIdentifier"
    },
    "catalog_version": {
      "const": "ai-experiments.semantic-ir.catalog/v2"
    },
    "function": {
      "$ref": "#/$defs/function"
    }
  },
  "$defs": {
    "effect": {
      "enum": [
        "db.read:users",
        "network.read:directory"
      ]
    },
    "function": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "symbol_id",
        "name",
        "parameters",
        "return_type",
        "effects",
        "body"
      ],
      "properties": {
        "symbol_id": {
          "$ref": "https://gptcode.dev/schemas/semantic-ir/program-ir-v0.schema.json#/$defs/semanticIdentifier"
        },
        "name": {
          "$ref": "https://gptcode.dev/schemas/semantic-ir/program-ir-v0.schema.json#/$defs/sourceIdentifier"
        },
        "parameters": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "https://gptcode.dev/schemas/semantic-ir/program-ir-v0.schema.json#/$defs/parameter"
          }
        },
        "return_type": {
          "const": "result<user,string>"
        },
        "effects": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/effect"
          }
        },
        "body": {
          "$ref": "https://gptcode.dev/schemas/semantic-ir/program-ir-v0.schema.json#/$defs/expression"
        }
      }
    }
  }
}
