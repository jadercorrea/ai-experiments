{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gptcode.dev/schemas/semantic-ir/final-task-suite-v0.schema.json",
  "title": "Final sealed semantic patch task suite v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "suite_id",
    "status",
    "candidate_suite",
    "tasks",
    "analysis_policy",
    "claim_boundary",
    "integrity"
  ],
  "properties": {
    "schema_version": {
      "const": "ai-experiments.semantic-ir.final-task-suite/v0"
    },
    "suite_id": {"type": "string", "minLength": 1},
    "status": {"const": "final_tasks_sealed_pre_model"},
    "candidate_suite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "suite_id", "suite_sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "suite_id": {"type": "string", "minLength": 1},
        "suite_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_task_id",
          "candidate_task_sha256",
          "instance_id",
          "task_root",
          "task_manifest_sha256",
          "hidden_evaluator_sha256",
          "final_semantic_disposition"
        ],
        "properties": {
          "candidate_task_id": {"type": "string", "minLength": 1},
          "candidate_task_sha256": {"$ref": "#/$defs/sha256"},
          "instance_id": {"type": "string", "minLength": 1},
          "task_root": {"$ref": "#/$defs/relativePath"},
          "task_manifest_sha256": {"$ref": "#/$defs/sha256"},
          "hidden_evaluator_sha256": {"$ref": "#/$defs/sha256"},
          "final_semantic_disposition": {"enum": ["supported", "unsupported"]}
        }
      }
    },
    "analysis_policy": {"type": "object"},
    "claim_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "concrete_tasks_sealed",
        "hidden_evaluators_sealed",
        "final_support_dispositions_locked",
        "contamination_audit_completed",
        "contamination_audit_path",
        "contamination_audit_sha256",
        "model_calls_authorized",
        "model_calls_observed",
        "efficacy_claim_authorized",
        "deferred"
      ],
      "properties": {
        "concrete_tasks_sealed": {"const": true},
        "hidden_evaluators_sealed": {"const": true},
        "final_support_dispositions_locked": {"const": true},
        "contamination_audit_completed": {"const": true},
        "contamination_audit_path": {"$ref": "#/$defs/relativePath"},
        "contamination_audit_sha256": {"$ref": "#/$defs/sha256"},
        "model_calls_authorized": {"const": false},
        "model_calls_observed": {"const": 0},
        "efficacy_claim_authorized": {"const": false},
        "deferred": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dependencies", "suite_sha256"],
      "properties": {
        "dependencies": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": {"$ref": "#/$defs/relativePath"},
              "sha256": {"$ref": "#/$defs/sha256"}
            }
          }
        },
        "suite_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
