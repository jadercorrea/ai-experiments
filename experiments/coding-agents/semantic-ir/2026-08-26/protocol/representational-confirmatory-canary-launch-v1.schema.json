{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gptcode.dev/schemas/semantic-ir/representational-confirmatory-canary-launch-v1.schema.json",
  "title": "Representational confirmatory protocol-v1 one-cell launch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "launch_id",
    "plan_id",
    "plan_sha256",
    "plan_repository_revision",
    "authorized_at",
    "authorization_message",
    "explicit_user_authorization",
    "protocol_freeze_file_sha256",
    "protocol_artifact_lock_sha256",
    "runner_file_sha256",
    "provider_model",
    "provider_endpoint",
    "credential_preflight_passed",
    "pricing_recheck_passed",
    "rates_usd_per_million_tokens",
    "participant_state_schema_version",
    "selected_cell",
    "authorized_cell_count",
    "prior_observed_cell_count",
    "blocked_cell_count",
    "maximum_provider_requests",
    "provider_retries",
    "maximum_total_spend_usd",
    "behavior_blind_operational_gate",
    "prior_canary_retry_authorized",
    "remaining_campaign_release_authorized"
  ],
  "properties": {
    "schema_version": {
      "const": "ai-experiments.semantic-ir.representational-confirmatory-canary-launch/v1"
    },
    "launch_id": {"const": "representational-confirmatory-canary-002"},
    "plan_id": {"const": "representational-confirmatory-canary-plan-002"},
    "plan_sha256": {"$ref": "#/$defs/sha256"},
    "plan_repository_revision": {"type": "string", "minLength": 1},
    "authorized_at": {"type": "string", "format": "date-time"},
    "authorization_message": {"type": "string", "minLength": 1},
    "explicit_user_authorization": {"const": true},
    "protocol_freeze_file_sha256": {"$ref": "#/$defs/sha256"},
    "protocol_artifact_lock_sha256": {"$ref": "#/$defs/sha256"},
    "runner_file_sha256": {"$ref": "#/$defs/sha256"},
    "provider_model": {"const": "us.anthropic.claude-sonnet-4-6"},
    "provider_endpoint": {
      "const": "https://bedrock-runtime.us-east-1.amazonaws.com"
    },
    "credential_preflight_passed": {"const": true},
    "pricing_recheck_passed": {"const": true},
    "rates_usd_per_million_tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "cached_input", "output"],
      "properties": {
        "input": {"const": 3.0},
        "cached_input": {"const": 0.3},
        "output": {"const": 15.0}
      }
    },
    "participant_state_schema_version": {
      "const": "ai-experiments.semantic-ir.representational-session-state/v1"
    },
    "selected_cell": {"$ref": "#/$defs/selectedCell"},
    "authorized_cell_count": {"const": 1},
    "prior_observed_cell_count": {"const": 1},
    "blocked_cell_count": {"const": 958},
    "maximum_provider_requests": {"const": 12},
    "provider_retries": {"const": 0},
    "maximum_total_spend_usd": {"const": 4.0},
    "behavior_blind_operational_gate": {"const": true},
    "prior_canary_retry_authorized": {"const": false},
    "remaining_campaign_release_authorized": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "selectedCell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "slot_id",
        "condition_id",
        "session_id",
        "workspace_id",
        "initial_request_sha256"
      ],
      "properties": {
        "sequence": {"const": 2},
        "slot_id": {"const": "capability_lookup_fallback-001"},
        "condition_id": {"const": "opaque_nested"},
        "session_id": {
          "const": "representational-confirmatory-v0/session/capability_lookup_fallback-001/a1/opaque_nested"
        },
        "workspace_id": {
          "const": "representational-confirmatory-v0/workspace/capability_lookup_fallback-001/a1/opaque_nested"
        },
        "initial_request_sha256": {
          "const": "bd230b535da6962f70ada16488553b8652addd35c44042043095848420e45cf8"
        }
      }
    }
  }
}
