{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gptcode.dev/schemas/semantic-ir/representational-confirmatory-canary-result-v0.schema.json",
  "title": "Representational confirmatory one-cell canary result v0",
  "type": "object",
  "required": [
    "schema_version",
    "launch_id",
    "cell",
    "terminal",
    "failure",
    "classification",
    "opcodes",
    "recoverable_tool_errors",
    "mutation_attempts",
    "public_evaluations",
    "hidden_evaluation",
    "usage",
    "estimated_cost_usd",
    "reserved_cost_usd",
    "operational_gate",
    "behavioral_outcome_used_by_operational_gate",
    "remaining_campaign_release_authorized"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "ai-experiments.semantic-ir.representational-confirmatory-canary-result/v0"
    },
    "launch_id": {"const": "representational-confirmatory-canary-001"},
    "cell": {"type": "object"},
    "terminal": {"type": "boolean"},
    "failure": {"type": ["string", "null"]},
    "failure_message": {"type": ["string", "null"]},
    "classification": {
      "enum": [
        "valid_terminal",
        "product_failure",
        "infrastructure_invalid",
        "spend_limit_stop"
      ]
    },
    "opcodes": {
      "type": "array",
      "items": {"enum": ["C", "R", "I", "L", "W", "E", "S", "F"]}
    },
    "recoverable_tool_errors": {"type": "integer", "minimum": 0},
    "mutation_attempts": {"type": "integer", "minimum": 0},
    "public_evaluations": {"type": "integer", "minimum": 0},
    "hidden_evaluation": {"type": ["object", "null"]},
    "workspace_tree_sha256": {"$ref": "#/$defs/sha256"},
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_requests",
        "input_tokens",
        "cached_input_tokens",
        "output_tokens",
        "total_tokens"
      ],
      "properties": {
        "provider_requests": {"type": "integer", "minimum": 0, "maximum": 12},
        "input_tokens": {"type": "integer", "minimum": 0},
        "cached_input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0}
      }
    },
    "estimated_cost_usd": {"type": "number", "minimum": 0, "maximum": 4},
    "reserved_cost_usd": {"type": "number", "minimum": 0, "maximum": 4},
    "duration_seconds": {"type": "number", "minimum": 0},
    "operational_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "criteria", "behavioral_outcome_considered"],
      "properties": {
        "passed": {"type": "boolean"},
        "criteria": {
          "type": "object",
          "additionalProperties": {"type": "boolean"}
        },
        "behavioral_outcome_considered": {"const": false}
      }
    },
    "behavioral_outcome_used_by_operational_gate": {"const": false},
    "remaining_campaign_release_authorized": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
