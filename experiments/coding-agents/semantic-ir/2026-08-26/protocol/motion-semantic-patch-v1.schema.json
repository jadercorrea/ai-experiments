{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gptcode.dev/schemas/semantic-ir/motion-semantic-patch-v1.schema.json",
  "title": "Lexicalized semantic motion patch v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "patch_id",
    "state_token",
    "operations"
  ],
  "properties": {
    "schema_version": {
      "const": "ai-experiments.semantic-ir.motion-patch/v1"
    },
    "patch_id": {
      "$ref": "#/$defs/semanticIdentifier"
    },
    "state_token": {
      "type": "string",
      "pattern": "^cap:v1:state:[0-9a-f]{32}$"
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/operation"
      }
    }
  },
  "$defs": {
    "semanticIdentifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?::[a-z][a-z0-9-]*)+$"
    },
    "reference": {
      "type": "string",
      "pattern": "^r[0-9]+$"
    },
    "bindingReference": {
      "type": "string",
      "pattern": "^b[0-9]+$"
    },
    "binding": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        {
          "$ref": "#/$defs/bindingReference"
        },
        {
          "type": "string",
          "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"
        },
        {
          "enum": [
            "string",
            "boolean",
            "user",
            "option<user>",
            "result<user,string>"
          ]
        }
      ],
      "items": false
    },
    "motion": {
      "type": "array",
      "minItems": 3,
      "maxItems": 6,
      "prefixItems": [
        {
          "enum": [
            "str",
            "var",
            "call",
            "let",
            "if",
            "match",
            "ok",
            "err"
          ]
        },
        {
          "$ref": "#/$defs/reference"
        }
      ],
      "items": {
        "type": "string"
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "target",
        "root",
        "bindings",
        "motions"
      ],
      "properties": {
        "operation_id": {
          "$ref": "#/$defs/semanticIdentifier"
        },
        "target": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {
              "type": "string",
              "pattern": "^n[0-9]+$"
            },
            {
              "type": "string",
              "pattern": "^cap:v1:target:[0-9a-f]{32}$"
            }
          ],
          "items": false
        },
        "root": {
          "$ref": "#/$defs/reference"
        },
        "bindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/binding"
          }
        },
        "motions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/motion"
          }
        }
      }
    }
  }
}
