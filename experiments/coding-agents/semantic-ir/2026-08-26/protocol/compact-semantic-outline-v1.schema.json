{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gptcode.dev/schemas/semantic-ir/compact-semantic-outline-v1.schema.json",
  "title": "Compact semantic context outline v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "program",
    "root",
    "node_fields",
    "nodes",
    "catalog_fields",
    "catalog"
  ],
  "properties": {
    "schema_version": {
      "const": "ai-experiments.semantic-ir.compact-outline/v1"
    },
    "program": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ir", "catalog", "function"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "ir": {"type": "string", "minLength": 1},
        "catalog": {"type": "string", "minLength": 1},
        "function": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "parameters", "returns", "effects"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "parameters": {
              "type": "array",
              "items": {
                "type": "array",
                "prefixItems": [
                  {"type": "string", "minLength": 1},
                  {"type": "string", "minLength": 1}
                ],
                "items": false
              }
            },
            "returns": {"type": "string", "minLength": 1},
            "effects": {
              "type": "array",
              "items": {"type": "string", "minLength": 1},
              "uniqueItems": true
            }
          }
        }
      }
    },
    "root": {"const": "n0"},
    "node_fields": {
      "const": ["handle", "op", "parent", "slot", "hint"]
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "prefixItems": [
          {"type": "string", "pattern": "^n[0-9]+$"},
          {"type": "string", "minLength": 1},
          {
            "oneOf": [
              {"type": "string", "pattern": "^n[0-9]+$"},
              {"type": "null"}
            ]
          },
          {"type": "string", "minLength": 1},
          {
            "oneOf": [
              {"type": "string", "minLength": 1},
              {"type": "null"}
            ]
          }
        ],
        "items": false
      }
    },
    "catalog_fields": {
      "const": ["symbol", "arguments", "result", "effect"]
    },
    "catalog": {
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {"type": "string", "minLength": 1},
          {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          {"type": "string", "minLength": 1},
          {
            "oneOf": [
              {"type": "string", "minLength": 1},
              {"type": "null"}
            ]
          }
        ],
        "items": false
      }
    }
  }
}
