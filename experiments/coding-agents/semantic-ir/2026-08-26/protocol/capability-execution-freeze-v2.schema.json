{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gptcode.dev/schemas/semantic-ir/capability-execution-freeze-v2.schema.json",
  "title": "Capability-mediated semantic execution freeze v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "freeze_id", "status", "purpose",
    "initial_user_message", "claim_boundary", "final_suite", "model_sources",
    "provider_access", "model", "sampling", "limits", "accounting",
    "isolation", "tasks", "schedule", "stopping_rule", "analysis_policy",
    "contamination", "launch_contract", "runner", "integrity"
  ],
  "properties": {
    "schema_version": {"const": "ai-experiments.semantic-ir.capability-execution-freeze/v2"},
    "freeze_id": {"const": "semantic-ir-capability-calibration/heterogeneous-patches-v2"},
    "status": {"const": "frozen_pre_execution"},
    "purpose": {"const": "calibration"},
    "initial_user_message": {"type": "string", "minLength": 1},
    "claim_boundary": {
      "type": "object",
      "required": ["execution_variables_complete", "model_calls_authorized", "experimental_subject_calls_observed", "efficacy_claim_authorized", "remaining_before_launch"],
      "properties": {
        "execution_variables_complete": {"const": true},
        "model_calls_authorized": {"const": false},
        "experimental_subject_calls_observed": {"const": 0},
        "efficacy_claim_authorized": {"const": false},
        "remaining_before_launch": {"const": ["explicit_launch"]}
      }
    },
    "final_suite": {"$ref": "#/$defs/dependency"},
    "model_sources": {"type": "object"},
    "provider_access": {"type": "object"},
    "model": {"type": "object"},
    "sampling": {"type": "object"},
    "limits": {
      "type": "object",
      "required": ["model_turns_per_call_cell", "tool_calls_per_turn", "mutation_attempts_per_cell", "public_evaluations_per_cell", "hidden_evaluations_per_cell", "provider_retries", "inference_timeout_seconds", "cell_timeout_seconds", "maximum_provider_requests", "maximum_total_spend_usd"],
      "properties": {
        "tool_calls_per_turn": {"const": 4},
        "provider_retries": {"const": 0}
      }
    },
    "accounting": {"type": "object"},
    "isolation": {
      "type": "object",
      "required": ["context_surface", "context_addressing", "tool_error_policy", "semantic_preconditions"],
      "properties": {
        "context_surface": {"const": "immutable_allowlisted_artifacts"},
        "context_addressing": {"const": "context_uri_handles"},
        "tool_error_policy": {"const": "typed_recoverable_results_within_turn_budget"},
        "semantic_preconditions": {"const": "opaque_capability_tokens_resolved_inside_trusted_boundary"}
      }
    },
    "tasks": {
      "type": "array", "minItems": 6, "maxItems": 6,
      "items": {"$ref": "#/$defs/task"}
    },
    "schedule": {
      "type": "object",
      "required": ["adaptive_ordering", "adaptive_stopping", "source_first_pairs", "semantic_first_pairs", "provider_call_cells", "cells"],
      "properties": {
        "adaptive_ordering": {"const": false},
        "adaptive_stopping": {"const": false},
        "cells": {
          "type": "array", "minItems": 12, "maxItems": 12,
          "items": {"$ref": "#/$defs/cell"}
        }
      }
    },
    "stopping_rule": {"type": "object"},
    "analysis_policy": {"type": "object"},
    "contamination": {"type": "object"},
    "launch_contract": {"$ref": "#/$defs/dependency"},
    "runner": {"$ref": "#/$defs/dependency"},
    "integrity": {
      "type": "object",
      "required": ["dependencies", "freeze_sha256"],
      "properties": {
        "dependencies": {"type": "array", "minItems": 8, "items": {"$ref": "#/$defs/dependency"}},
        "freeze_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relativePath": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"},
    "dependency": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "task": {
      "type": "object",
      "required": ["candidate_task_id", "instance_id", "slug", "task_root", "task_manifest_sha256", "workspace_tree_sha256", "hidden_evaluator_sha256", "final_semantic_disposition"]
    },
    "contextArtifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "bytes", "sha256", "ordered_sources", "manifest_path", "manifest_sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "ordered_sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/relativePath"}},
        "manifest_path": {"$ref": "#/$defs/relativePath"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "toolArtifact": {
      "type": "object", "required": ["path", "bytes", "sha256"]
    },
    "cell": {
      "type": "object",
      "required": ["sequence", "cell_id", "candidate_task_id", "task_root", "arm", "provider_call", "context", "tools", "terminal_policy"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1, "maximum": 12},
        "arm": {"enum": ["source", "semantic"]},
        "provider_call": {"type": "boolean"},
        "context": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/contextArtifact"}]},
        "tools": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/toolArtifact"}]}
      }
    }
  }
}
