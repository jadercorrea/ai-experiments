{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gptcode.dev/schemas/semantic-ir/compact-semantic-inspection-v1.schema.json",
  "title": "Compact semantic context inspection v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "program_id",
    "state_token",
    "scope_fields",
    "targets"
  ],
  "properties": {
    "schema_version": {
      "const": "ai-experiments.semantic-ir.compact-inspection/v1"
    },
    "program_id": {"type": "string", "minLength": 1},
    "state_token": {
      "type": "string",
      "pattern": "^cap:v1:state:[0-9a-f]{32}$"
    },
    "scope_fields": {
      "const": ["symbol_id", "name", "type"]
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "handle",
          "node_id",
          "op",
          "parent",
          "slot",
          "target_token",
          "scope",
          "subtree"
        ],
        "properties": {
          "handle": {"type": "string", "pattern": "^n[0-9]+$"},
          "node_id": {"type": "string", "minLength": 1},
          "op": {"type": "string", "minLength": 1},
          "parent": {
            "oneOf": [
              {"type": "string", "pattern": "^n[0-9]+$"},
              {"type": "null"}
            ]
          },
          "slot": {"type": "string", "minLength": 1},
          "target_token": {
            "type": "string",
            "pattern": "^cap:v1:target:[0-9a-f]{32}$"
          },
          "scope": {
            "type": "array",
            "items": {
              "type": "array",
              "prefixItems": [
                {"type": "string", "minLength": 1},
                {"type": "string", "minLength": 1},
                {"type": "string", "minLength": 1}
              ],
              "items": false
            }
          },
          "subtree": {
            "type": "object",
            "required": ["node_id", "op"]
          }
        }
      }
    }
  }
}
