{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gptcode.dev/schemas/semantic-ir/execution-freeze-v0.schema.json",
  "title": "Semantic patch calibration execution freeze v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "freeze_id",
    "status",
    "purpose",
    "initial_user_message",
    "claim_boundary",
    "final_suite",
    "model_sources",
    "provider_access",
    "model",
    "sampling",
    "limits",
    "accounting",
    "isolation",
    "tasks",
    "schedule",
    "stopping_rule",
    "analysis_policy",
    "contamination",
    "launch_contract",
    "runner",
    "integrity"
  ],
  "properties": {
    "schema_version": {"const": "ai-experiments.semantic-ir.execution-freeze/v0"},
    "freeze_id": {"const": "semantic-ir-calibration/heterogeneous-patches-v0"},
    "status": {"const": "frozen_pre_execution"},
    "purpose": {"const": "calibration"},
    "initial_user_message": {"type": "string", "minLength": 1},
    "claim_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_variables_complete",
        "model_calls_authorized",
        "experimental_subject_calls_observed",
        "efficacy_claim_authorized",
        "remaining_before_launch"
      ],
      "properties": {
        "execution_variables_complete": {"const": true},
        "model_calls_authorized": {"const": false},
        "experimental_subject_calls_observed": {"const": 0},
        "efficacy_claim_authorized": {"const": false},
        "remaining_before_launch": {"const": ["explicit_launch"]}
      }
    },
    "final_suite": {"$ref": "#/$defs/dependency"},
    "model_sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_lock", "hosted_access"],
      "properties": {
        "model_lock": {"$ref": "#/$defs/repositoryDependency"},
        "hosted_access": {"$ref": "#/$defs/repositoryDependency"}
      }
    },
    "provider_access": {"type": "object"},
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "provider_model",
        "foundation_model",
        "api_format",
        "region",
        "experiment_context_length",
        "identity_policy",
        "provider_substitution_allowed"
      ],
      "properties": {
        "provider": {"const": "Amazon Bedrock"},
        "provider_model": {"type": "string", "minLength": 1},
        "foundation_model": {"type": "string", "minLength": 1},
        "api_format": {"const": "bedrock-converse"},
        "region": {"const": "us-east-1"},
        "experiment_context_length": {"type": "integer", "minimum": 1},
        "identity_policy": {"const": "endpoint_locked_model_and_iam_scope"},
        "provider_substitution_allowed": {"const": false}
      }
    },
    "sampling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["temperature", "maximum_output_tokens_per_turn", "seed"],
      "properties": {
        "temperature": {"const": 0},
        "maximum_output_tokens_per_turn": {"const": 4096},
        "seed": {"const": null}
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_turns_per_call_cell",
        "tool_calls_per_turn",
        "mutation_attempts_per_cell",
        "public_evaluations_per_cell",
        "hidden_evaluations_per_cell",
        "provider_retries",
        "inference_timeout_seconds",
        "cell_timeout_seconds",
        "maximum_provider_requests",
        "maximum_total_spend_usd"
      ],
      "properties": {
        "model_turns_per_call_cell": {"const": 12},
        "tool_calls_per_turn": {"const": 4},
        "mutation_attempts_per_cell": {"const": 3},
        "public_evaluations_per_cell": {"const": 2},
        "hidden_evaluations_per_cell": {"const": 1},
        "provider_retries": {"const": 0},
        "inference_timeout_seconds": {"const": 300},
        "cell_timeout_seconds": {"const": 900},
        "maximum_provider_requests": {"const": 132},
        "maximum_total_spend_usd": {"const": 10.0}
      }
    },
    "accounting": {"type": "object"},
    "isolation": {"type": "object"},
    "tasks": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {"$ref": "#/$defs/task"}
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adaptive_ordering",
        "adaptive_stopping",
        "source_first_pairs",
        "semantic_first_pairs",
        "provider_call_cells",
        "cells"
      ],
      "properties": {
        "adaptive_ordering": {"const": false},
        "adaptive_stopping": {"const": false},
        "source_first_pairs": {"const": 3},
        "semantic_first_pairs": {"const": 3},
        "provider_call_cells": {"const": 11},
        "cells": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "items": {"$ref": "#/$defs/cell"}
        }
      }
    },
    "stopping_rule": {"type": "object"},
    "analysis_policy": {"type": "object"},
    "contamination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audit", "status", "prelaunch_repeat_required"],
      "properties": {
        "audit": {"$ref": "#/$defs/dependency"},
        "status": {"const": "conditional_pre_model_clearance"},
        "prelaunch_repeat_required": {"const": true}
      }
    },
    "launch_contract": {"$ref": "#/$defs/dependency"},
    "runner": {"$ref": "#/$defs/dependency"},
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dependencies", "freeze_sha256"],
      "properties": {
        "dependencies": {
          "type": "array",
          "minItems": 4,
          "items": {"$ref": "#/$defs/dependency"}
        },
        "freeze_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "repositoryDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_task_id",
        "instance_id",
        "slug",
        "task_root",
        "task_manifest_sha256",
        "workspace_tree_sha256",
        "hidden_evaluator_sha256",
        "final_semantic_disposition"
      ],
      "properties": {
        "candidate_task_id": {"type": "string", "minLength": 1},
        "instance_id": {"type": "string", "minLength": 1},
        "slug": {"type": "string", "minLength": 1},
        "task_root": {"$ref": "#/$defs/relativePath"},
        "task_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "workspace_tree_sha256": {"$ref": "#/$defs/sha256"},
        "hidden_evaluator_sha256": {"$ref": "#/$defs/sha256"},
        "final_semantic_disposition": {"enum": ["supported", "unsupported"]}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256", "ordered_sources"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "ordered_sources": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/relativePath"}
        }
      }
    },
    "toolArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "cell_id",
        "candidate_task_id",
        "task_root",
        "arm",
        "provider_call",
        "context",
        "tools",
        "terminal_policy"
      ],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1, "maximum": 12},
        "cell_id": {"type": "string", "minLength": 1},
        "candidate_task_id": {"type": "string", "minLength": 1},
        "task_root": {"$ref": "#/$defs/relativePath"},
        "arm": {"enum": ["source", "semantic"]},
        "provider_call": {"type": "boolean"},
        "context": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/artifact"}]},
        "tools": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/toolArtifact"}]},
        "terminal_policy": {
          "enum": ["agent_submission_finish", "orchestrator_semantic_unsupported"]
        }
      }
    }
  }
}
