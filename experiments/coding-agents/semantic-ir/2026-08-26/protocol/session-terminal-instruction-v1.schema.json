{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gptcode.dev/schemas/semantic-ir/session-terminal-instruction-v1.schema.json",
  "title": "Phase-specialized terminal session instruction v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "i",
        "a"
      ],
      "properties": {
        "i": {
          "const": "E"
        },
        "a": {
          "type": "array",
          "maxItems": 0,
          "items": false
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "i",
        "a"
      ],
      "properties": {
        "i": {
          "const": "S"
        },
        "a": {
          "oneOf": [
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "prefixItems": [
                {
                  "type": "string",
                  "minLength": 1
                }
              ],
              "items": false
            },
            {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "prefixItems": [
                {
                  "$ref": "#/$defs/semanticIdentifier"
                },
                {
                  "type": "string",
                  "pattern": "^cap:v1:state:[0-9a-f]{32}$"
                },
                {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/semanticOperation"
                  }
                }
              ],
              "items": false
            }
          ]
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "i",
        "a"
      ],
      "properties": {
        "i": {
          "const": "F"
        },
        "a": {
          "type": "array",
          "maxItems": 0,
          "items": false
        }
      }
    }
  ],
  "$defs": {
    "semanticIdentifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?::[a-z][a-z0-9-]*)+$"
    },
    "reference": {
      "type": "string",
      "pattern": "^r[0-9]+$"
    },
    "bindingReference": {
      "type": "string",
      "pattern": "^b[0-9]+$"
    },
    "target": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "type": "string",
          "pattern": "^n[0-9]+$"
        },
        {
          "type": "string",
          "pattern": "^cap:v1:target:[0-9a-f]{32}$"
        }
      ],
      "items": false
    },
    "binding": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        {
          "$ref": "#/$defs/bindingReference"
        },
        {
          "type": "string",
          "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"
        },
        {
          "enum": [
            "string",
            "boolean",
            "user",
            "option<user>",
            "result<user,string>"
          ]
        }
      ],
      "items": false
    },
    "motion": {
      "type": "array",
      "minItems": 3,
      "maxItems": 6,
      "prefixItems": [
        {
          "enum": [
            "str",
            "var",
            "call",
            "let",
            "if",
            "match",
            "ok",
            "err"
          ]
        },
        {
          "$ref": "#/$defs/reference"
        }
      ],
      "items": {
        "type": "string"
      }
    },
    "semanticOperation": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "prefixItems": [
        {
          "$ref": "#/$defs/semanticIdentifier"
        },
        {
          "$ref": "#/$defs/target"
        },
        {
          "$ref": "#/$defs/reference"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/binding"
          }
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/motion"
          }
        }
      ],
      "items": false
    }
  }
}
