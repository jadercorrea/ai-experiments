{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gptcode.dev/schemas/semantic-ir/representational-confirmatory-canary-plan-v1.schema.json",
  "title": "Representational confirmatory protocol-v1 canary plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "repository_revision",
    "provider_call_authorized",
    "provider_model",
    "provider_endpoint",
    "protocol_freeze_file_sha256",
    "protocol_artifact_lock_sha256",
    "prior_canary_result_sha256",
    "prior_canary_artifact_lock_sha256",
    "runner_file_sha256",
    "base_canary_runner_file_sha256",
    "plan_schema_file_sha256",
    "launch_schema_file_sha256",
    "result_schema_file_sha256",
    "participant_state_schema_version",
    "selection_rule",
    "selection_adaptive",
    "selected_cell",
    "planned_cell_count",
    "prior_observed_cell_count",
    "blocked_cell_count",
    "maximum_provider_requests",
    "provider_retries",
    "maximum_total_spend_usd",
    "behavior_blind_operational_gate",
    "prior_canary_retry_authorized",
    "remaining_campaign_release_authorized",
    "transmission_scope"
  ],
  "properties": {
    "schema_version": {
      "const": "ai-experiments.semantic-ir.representational-confirmatory-canary-plan/v1"
    },
    "plan_id": {"const": "representational-confirmatory-canary-plan-002"},
    "repository_revision": {"type": "string", "minLength": 1},
    "provider_call_authorized": {"const": false},
    "provider_model": {"const": "us.anthropic.claude-sonnet-4-6"},
    "provider_endpoint": {
      "const": "https://bedrock-runtime.us-east-1.amazonaws.com"
    },
    "protocol_freeze_file_sha256": {"$ref": "#/$defs/sha256"},
    "protocol_artifact_lock_sha256": {"$ref": "#/$defs/sha256"},
    "prior_canary_result_sha256": {"$ref": "#/$defs/sha256"},
    "prior_canary_artifact_lock_sha256": {"$ref": "#/$defs/sha256"},
    "runner_file_sha256": {"$ref": "#/$defs/sha256"},
    "base_canary_runner_file_sha256": {"$ref": "#/$defs/sha256"},
    "plan_schema_file_sha256": {"$ref": "#/$defs/sha256"},
    "launch_schema_file_sha256": {"$ref": "#/$defs/sha256"},
    "result_schema_file_sha256": {"$ref": "#/$defs/sha256"},
    "participant_state_schema_version": {
      "const": "ai-experiments.semantic-ir.representational-session-state/v1"
    },
    "selection_rule": {
      "const": "second cell in the immutable confirmatory schedule"
    },
    "selection_adaptive": {"const": false},
    "selected_cell": {"$ref": "#/$defs/selectedCell"},
    "planned_cell_count": {"const": 1},
    "prior_observed_cell_count": {"const": 1},
    "blocked_cell_count": {"const": 958},
    "maximum_provider_requests": {"const": 12},
    "provider_retries": {"const": 0},
    "maximum_total_spend_usd": {"const": 4.0},
    "behavior_blind_operational_gate": {"const": true},
    "prior_canary_retry_authorized": {"const": false},
    "remaining_campaign_release_authorized": {"const": false},
    "transmission_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["included", "excluded"],
      "properties": {
        "included": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "excluded": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "selectedCell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "slot_id",
        "condition_id",
        "session_id",
        "workspace_id",
        "initial_request_sha256"
      ],
      "properties": {
        "sequence": {"const": 2},
        "slot_id": {"const": "capability_lookup_fallback-001"},
        "condition_id": {"const": "opaque_nested"},
        "session_id": {
          "const": "representational-confirmatory-v0/session/capability_lookup_fallback-001/a1/opaque_nested"
        },
        "workspace_id": {
          "const": "representational-confirmatory-v0/workspace/capability_lookup_fallback-001/a1/opaque_nested"
        },
        "initial_request_sha256": {
          "const": "bd230b535da6962f70ada16488553b8652addd35c44042043095848420e45cf8"
        }
      }
    }
  }
}
