+func TestDecompress_CaseInsensitiveContentEncoding(t *testing.T) {
+	e := echo.New()
+
+	h := Decompress()(func(c *echo.Context) error {
+		b, err := io.ReadAll(c.Request().Body)
+		if err != nil {
+			return err
+		}
+		return c.String(http.StatusOK, string(b))
+	})
+
+	body := `{"name": "echo"}`
+	for _, encoding := range []string{"gzip", "GZIP", "Gzip", "GZip", "gZIP"} {
+		gz, _ := gzipString(body)
+		req := httptest.NewRequest(http.MethodPost, "/", bytes.NewReader(gz))
+		req.Header.Set(echo.HeaderContentEncoding, encoding)
+		rec := httptest.NewRecorder()
+		c := e.NewContext(req, rec)
+
+		err := h(c)
+		assert.NoError(t, err, "encoding: %s", encoding)
+		assert.Equal(t, body, rec.Body.String(), "encoding: %s", encoding)
+	}
+}
