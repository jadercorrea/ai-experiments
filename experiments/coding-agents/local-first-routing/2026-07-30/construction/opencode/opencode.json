{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "gateway": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Experiment gateway",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1"
      },
      "models": {
        "qwen3-coder:30b-a3b-q4_K_M": {
          "name": "Qwen3 Coder through experiment gateway",
          "limit": {
            "context": 65536,
            "output": 64000
          }
        }
      }
    }
  },
  "agent": {
    "pilot": {
      "description": "Contained construction-pilot coding agent",
      "mode": "primary",
      "model": "gateway/qwen3-coder:30b-a3b-q4_K_M"
    }
  }
}
