# syntax=docker/dockerfile:1.19
ARG BASE_IMAGE=golang:1.25-bookworm@sha256:ea341baa9bd5ba6784f6d7161ace70544349a6242d54d34a0fbfd2c4d51c9d58
FROM ${BASE_IMAGE} AS relay-build

USER root
COPY tools/socket-relay /tmp/socket-relay
RUN cd /tmp/socket-relay && \
    go test ./... && \
    go build -trimpath -ldflags="-s -w" -o /socket-relay .

ARG BASE_IMAGE=golang:1.25-bookworm@sha256:ea341baa9bd5ba6784f6d7161ace70544349a6242d54d34a0fbfd2c4d51c9d58
FROM ${BASE_IMAGE}

USER root
COPY --from=relay-build /socket-relay /usr/local/bin/socket-relay
ADD --checksum=sha256:b16bd7593ea960a25d9c6849b3023bcd9b9244a6f51675341fd2052043b0670f \
    https://github.com/anomalyco/opencode/releases/download/v1.18.9/opencode-linux-arm64.tar.gz \
    /tmp/opencode.tar.gz
RUN tar --extract --gzip --file=/tmp/opencode.tar.gz --directory=/usr/local/bin && \
    rm /tmp/opencode.tar.gz && \
    test "$(/usr/local/bin/opencode --version)" = "1.18.9"

USER evaluator
