FROM python:3.13-slim-bookworm@sha256:9d7f287598e1a5a978c015ee176d8216435aaf335ed69ac3c38dd1bbb10e8d64

RUN useradd --create-home --uid 10001 gateway
WORKDIR /app
COPY scripts/bedrock_converse.py scripts/inference_gateway.py \
     scripts/keychain_secrets.py scripts/routing_policy.py /app/
USER gateway

ENTRYPOINT ["python", "/app/inference_gateway.py", "--listen", "0.0.0.0"]
