diff --git a/suite/stats.go b/suite/stats.go
index be4ccd6..14cf1a0 100644
--- a/suite/stats.go
+++ b/suite/stats.go
@@ -25,9 +25,13 @@ func (s *SuiteInformation) start(testName string) {
 	if s == nil {
 		return
 	}
-	s.TestStats[testName] = &TestInformation{
-		TestName: testName,
-		Start:    time.Now(),
+	
+	// Only create the entry if it doesn't exist
+	if _, exists := s.TestStats[testName]; !exists {
+		s.TestStats[testName] = &TestInformation{
+			TestName: testName,
+			Start:    time.Now(),
+		}
 	}
 }
 
@@ -35,6 +39,12 @@ func (s *SuiteInformation) end(testName string, passed bool) {
 	if s == nil {
 		return
 	}
+	
+	// Ensure the test entry exists before trying to update it
+	if _, exists := s.TestStats[testName]; !exists {
+		return
+	}
+	
 	s.TestStats[testName].End = time.Now()
 	s.TestStats[testName].Passed = passed
 }
