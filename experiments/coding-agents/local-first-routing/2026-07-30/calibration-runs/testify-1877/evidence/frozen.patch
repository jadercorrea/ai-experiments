+package suite
+
+import (
+	"testing"
+)
+
+type StatsSuite struct {
+	Suite
+}
+
+func (s *StatsSuite) SetupSuite() {
+	s.T().Skip()
+}
+
+func (s *StatsSuite) TestNothing() {
+	// This test should never run since SetupSuite skips
+}
+
+func TestSuiteSetupSkips(t *testing.T) {
+	suite := new(StatsSuite)
+	Run(t, suite)
+}
