+func TestDecompress_CaseInsensitive(t *testing.T) {
+	e := echo.New()
+
+	h := Decompress()(func(c *echo.Context) error {
+		c.Response().Write([]byte("test"))
+		return nil
+	})
+
+	// Test with uppercase GZIP encoding - should still decompress 
+	body := `{"name": "echo"}`
+	gz, _ := gzipString(body)
+	req := httptest.NewRequest(http.MethodPost, "/", strings.NewReader(string(gz)))
+	req.Header.Set(echo.HeaderContentEncoding, "GZIP") // Uppercase
+	rec := httptest.NewRecorder()
+	c := e.NewContext(req, rec)
+
+	err := h(c)
+	assert.NoError(t, err)
+
+	// Should decompress despite uppercase
+	b, err := io.ReadAll(req.Body)
+	assert.NoError(t, err)
+	assert.Equal(t, body, string(b))
+}
